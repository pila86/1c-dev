# Scaffold defaults for bsl-search app profile (ADR-033 / #175).
# Loopback ports chosen to avoid clash with v8std (18765/18766).
BSL_SEARCH_MCP_PORT=18005
BSL_SEARCH_API_PORT=18080

# Image pins — REPLACE_ME until Этап 3 (published tags or documented build).
BSL_SEARCH_MCP_IMAGE=REPLACE_ME
BSL_SEARCH_API_IMAGE=REPLACE_ME

# External dependencies (user must provide — not started by 1c-dev in app profile).
ELASTICSEARCH_URL=http://127.0.0.1:9200/
ELASTICSEARCH_HOST=
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=bsl-methods-full
ELASTICSEARCH_KNOWLEDGE_INDEX=bsl-knowledge
ELASTICSEARCH_API_KEY=
EMBEDDING_URL=http://127.0.0.1:8081/v1
RERANKER_URL=http://127.0.0.1:8082/v1
EMBEDDING_KEY=
RERANKER_KEY=
MCP_AUTH_TOKEN=
LOG_LEVEL=ERROR
