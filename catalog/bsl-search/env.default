# bsl-search managed stack (ADR-033 Этап 3 / #175)

# Host ports (loopback). Change if busy.
BSL_SEARCH_ES_PORT=19200
BSL_SEARCH_API_PORT=18080
BSL_SEARCH_MCP_PORT=18005

# Elasticsearch image pin (SoT: maintainers 1c-dev).
BSL_SEARCH_ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.15.3
BSL_SEARCH_ES_JAVA_OPTS=-Xms2g -Xmx2g
BSL_SEARCH_ES_MEM_LIMIT=3g

# Index names inside ES (search-api).
ELASTICSEARCH_INDEX=bsl-methods
ELASTICSEARCH_KNOWLEDGE_INDEX=bsl-knowledge
ELASTICSEARCH_API_KEY=

# Optional inference — leave empty for BM25-only.
# Later: local CPU (llama.cpp) or remote URLs; then: services restart bsl-search
EMBEDDING_URL=
RERANKER_URL=
EMBEDDING_KEY=
RERANKER_KEY=
EMBEDDING_MODEL=
RERANKER_MODEL=

# HuggingFace (optional; public dataset works without token).
HF_TOKEN=

MCP_AUTH_TOKEN=
LOG_LEVEL=ERROR

# Set to 1 to force re-bulk on next services up (even if index non-empty).
BSL_SEARCH_REINDEX=0
