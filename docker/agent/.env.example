# Copy to docker/agent/.env and edit (file is gitignored).
# Do not commit real URLs, tokens, or org hostnames.

# =============================================================================
# 1C / HASP
# =============================================================================
HASP_SERVER_ADDR=192.168.0.10
VNC_PASSWORD=
VNC_PORT=5901
EDT_JAVA_XMX=8g
MEM_LIMIT=16g

# =============================================================================
# Proxy / org CA
# =============================================================================
ORG_CERTS_HOST_DIR=./certs
# HTTP_PROXY=http://proxy.example.corp:3128
# HTTPS_PROXY=http://proxy.example.corp:3128
# NO_PROXY=localhost,127.0.0.1,.example.corp,192.168.0.0/16,bsl-ls,v8std-mcp,v8std,v8std-site,mcp,mcp-atlassian
PROXY_ENV_FILE=./proxy.env

# =============================================================================
# Agent Canvas
# =============================================================================
OPENHANDS_APP_IMAGE=ghcr.io/openhands/agent-canvas:latest
OPENHANDS_PORT=3000
OH_CONVERSATION_RUNTIME=docker
OH_CONVERSATION_IMAGE=1c-agent-oh:8.5.1-edt2026.2
OH_CONVERSATION_CONTAINER_MEMORY=16g
AGENT_SERVER_IMAGE_REPOSITORY=1c-agent-oh
AGENT_SERVER_IMAGE_TAG=8.5.1-edt2026.2
OH_AGENT_SERVER_VERSION=1.64.1
PROJECTS_DIR=./projects
DOCKER_GID=137
# Canvas Settings/conversations. Path must be the SAME on host and in container
# (docker.sock bind mounts). openhands-init chowns to uid 10001 on every up.
OPENHANDS_DATA_DIR=/home/openhands/.openhands
# Optional named volumes injected into conversations:
# TOOLCHAIN_CACHE_VOLUME=1c-agent_toolchain_cache
# TOOLS_SHARE_VOLUME=1c-agent_tools_share
# LOCAL_BACKEND_API_KEY=
# OH_SECRET_KEY=
AGENT_CANVAS_DISABLE_TELEMETRY=1

# Absolute host path to this directory (wrapper binds entrypoint + scripts into chats)
OH_AGENT_HOST_DIR=/absolute/path/to/1c-dev/docker/agent
OH_COMPOSE_NETWORK=1c-agent_default

# sandbox-debug (--profile debug)
SESSION_API_KEY=dev-local-key
SANDBOX_PORT=18000

# =============================================================================
# Workspaces (multi-project)
# =============================================================================
# Absolute host dir with one subdirectory per project (you clone them yourself).
# Canvas agent profile name == subdirectory name → that checkout becomes /workspace.
# bsl-ls mounts the whole root at /workspaces (register_workspace_folder).
OH_WORKSPACES_ROOT=/absolute/path/to/oh-workspaces
OH_DEFAULT_PROJECT=my-repo
# Optional: comma-separated slugs to seed as agent profiles (default = all .git subdirs)
# OH_PROJECT_SLUGS=my-repo,other-repo
GIT_AUTHOR_NAME="OpenHands Agent"
GIT_AUTHOR_EMAIL=openhands@local
# ACL u:10001 on projects is applied by openhands-init on every compose up.
# Manual refresh without restart: ./docker/agent/scripts/grant-workspace-acl.sh

# =============================================================================
# LLM (seeded into Canvas Settings by openhands-bootstrap)
# =============================================================================
LLM_PROVIDER_NAME=local-openai
LLM_PROVIDER=openai
LLM_BASE_URL=https://llm.example.corp/api/v1/
LLM_API_KEY=
LLM_MODEL=openai/qwen3.8:27b
LLM_PROFILE_NAME=local-qwen
LLM_NATIVE_TOOL_CALLING=true
LLM_REASONING_EFFORT=none
LLM_MAX_INPUT_TOKENS=210000
LLM_MAX_OUTPUT_TOKENS=32000

# =============================================================================
# Sibling MCP (URLs for Canvas Settings; conversation reaches them via forwarder)
# =============================================================================
MCP_HTTP_SERVERS=bsl-ls,v8std,atlassian
# Host publish ports (change if defaults clash with another local stack)
BSLLS_MCP_PORT=18767
V8STD_MCP_PORT=18766
MCP_BSL_LS_URL=http://127.0.0.1:18767/mcp
MCP_V8STD_URL=http://127.0.0.1:18766/mcp
MCP_ATLASSIAN_URL=http://127.0.0.1:18768/mcp
MCP_ATLASSIAN_PORT=18768
MCP_BOOTSTRAP_WAIT_SECS=180

# =============================================================================
# mcp-atlassian (Jira/Confluence sibling; not STDIO uvx in sandbox)
# =============================================================================
# Cloud: JIRA_USERNAME + JIRA_API_TOKEN
# Server/DC: JIRA_PERSONAL_TOKEN
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PERSONAL_TOKEN=
JIRA_SSL_VERIFY=false
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
CONFLUENCE_PERSONAL_TOKEN=
CONFLUENCE_SSL_VERIFY=false
