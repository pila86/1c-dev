# Copy to docker/agent/.env and edit (file is gitignored).

# --- 1C / HASP ---
HASP_SERVER_ADDR=192.168.150.182
VNC_PASSWORD=
VNC_PORT=5901
EDT_JAVA_XMX=8g
MEM_LIMIT=16g

# --- Org certificates ---
# Host dir with *.crt / *.pem (mounted to /certs in containers)
ORG_CERTS_HOST_DIR=./certs

# --- HTTP(S) proxy to corp network ---
# HTTP_PROXY=http://proxy.example.corp:3128
# HTTPS_PROXY=http://proxy.example.corp:3128
# NO_PROXY=localhost,127.0.0.1,.example.corp,192.168.0.0/16
# Optional file mount for sandbox-debug (create empty file if unused):
PROXY_ENV_FILE=./proxy.env

# --- OpenHands / Agent Canvas ---
OPENHANDS_APP_IMAGE=ghcr.io/openhands/agent-canvas:latest
OPENHANDS_PORT=3000
# Conversations → our sandbox image (docker runtime)
OH_CONVERSATION_RUNTIME=docker
OH_CONVERSATION_IMAGE=1c-agent-oh:8.5.1-edt2026.2
OH_CONVERSATION_CONTAINER_MEMORY=16g
AGENT_SERVER_IMAGE_REPOSITORY=1c-agent-oh
AGENT_SERVER_IMAGE_TAG=8.5.1-edt2026.2
OH_AGENT_SERVER_VERSION=1.64.1
# writable by uid 10001 (openhands); default ./projects under docker/agent
PROJECTS_DIR=./projects
# Must be the SAME absolute path on host and in Canvas (docker.sock bind mounts).
# Create once: docker run --rm -v /home/openhands:/home/openhands alpine chown -R 10001:10001 /home/openhands
OPENHANDS_HOST_DATA_DIR=/home/openhands/.openhands
DOCKER_GID=137
# LOCAL_BACKEND_API_KEY=
# OH_SECRET_KEY=
AGENT_CANVAS_DISABLE_TELEMETRY=1

# sandbox-debug health auth (only for --profile debug)
SESSION_API_KEY=dev-local-key
SANDBOX_PORT=18000

# --- Git workspace (bind-mount into conversation /workspace; no clone on build) ---
# Existing host checkout (RW). Then: ./docker/agent/scripts/grant-workspace-acl.sh
GIT_REPO_HOST_PATH=/home/you/work/repo
GIT_REPO_URL=git@gitlab.example.corp:group/repo.git
GIT_BRANCH=dev
GIT_AUTHOR_NAME="OpenHands Agent"
GIT_AUTHOR_EMAIL=openhands@local

# --- Sibling MCP (compose DNS; conversation joins 1c-agent_default) ---
OH_COMPOSE_NETWORK=1c-agent_default
# Absolute host path to this directory (entrypoint+scripts bind into conversations)
OH_AGENT_HOST_DIR=/home/you/work/my/1c-dev/docker/agent
MCP_HTTP_SERVERS=bsl-ls,v8std,atlassian
# 127.0.0.1 + published ports (Canvas Test); conversation forwards to siblings
MCP_BSL_LS_URL=http://127.0.0.1:18767/mcp
MCP_V8STD_URL=http://127.0.0.1:18766/mcp
MCP_ATLASSIAN_URL=http://127.0.0.1:18768/mcp
MCP_ATLASSIAN_PORT=18768
# Optional legacy host Test sidecar: --profile mcp-http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=9100

# --- mcp-atlassian (Jira/Confluence; sibling HTTP, not STDIO uvx in sandbox) ---
# Cloud:
#   JIRA_URL=https://your-company.atlassian.net
#   JIRA_USERNAME=you@company.com
#   JIRA_API_TOKEN=...
# Server/Data Center:
#   JIRA_URL=https://jira.example.corp
#   JIRA_PERSONAL_TOKEN=...
# Optional Confluence (same pattern: USERNAME+API_TOKEN or PERSONAL_TOKEN):
#   CONFLUENCE_URL=https://confluence.example.corp
#   CONFLUENCE_PERSONAL_TOKEN=...
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PERSONAL_TOKEN=
# Corp proxy MITM / private CA (jira often only via HTTP_PROXY): usually false
JIRA_SSL_VERIFY=false
CONFLUENCE_URL=
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
CONFLUENCE_PERSONAL_TOKEN=
CONFLUENCE_SSL_VERIFY=false

# --- Toolchain cache / share (persisted across conversations) ---
TOOLCHAIN_CACHE_HOST_DIR=/home/openhands/.openhands/1c-dev-cache
TOOLS_SHARE_HOST_DIR=/home/openhands/.openhands/1c-dev-share
# Sibling MCP in compose — keep bootstrap off inside conversation
SKIP_TOOLS_BOOTSTRAP=1
TOOLS_BOOTSTRAP_SERVICES=
