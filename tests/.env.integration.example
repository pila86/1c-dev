# cp tests/.env.integration.example tests/.env.integration
# Не коммитить tests/.env.integration.
# Process env (LLM_*) перекрывает значения из файла.
#
# Вариант A — бесплатная/встроенная модель OpenCode (URL/key не нужны):
#   LLM_MODEL=opencode/glm-5.3-flash-free
#   LLM_STEPS=50
#
# Вариант B — свой openai-compatible endpoint:

LLM_BASE_URL=https://llm.example.com/v1
LLM_API_KEY=CHANGEME
LLM_MODEL=my-model
# LLM_PROVIDER=llm
LLM_VERIFY_SSL=false
LLM_STEPS=50

# HTTP_PROXY=http://127.0.0.1:8118
# HTTPS_PROXY=http://127.0.0.1:8118
# NO_PROXY=localhost,127.0.0.1

# OpenAI-compatible aliases (optional; filled from LLM_* if empty)
# OPENAI_BASE_URL=
# OPENAI_API_KEY=

# Node/agent runners: proxy + self-signed TLS (для варианта B)
# NODE_USE_ENV_PROXY=1
# NODE_TLS_REJECT_UNAUTHORIZED=0
