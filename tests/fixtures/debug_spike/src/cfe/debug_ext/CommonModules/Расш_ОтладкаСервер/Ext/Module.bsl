Функция Дополнить(Сценарий = "") Экспорт

	РасширениеЗначение = 7;
	РасширениеРезультат = РасширениеЗначение * 6;
	РасширениеСообщение = СтрШаблон("%1 → %2", Сценарий, РасширениеРезультат); // BP-LINE-EXT-SERVER
	Возврат РасширениеРезультат;

