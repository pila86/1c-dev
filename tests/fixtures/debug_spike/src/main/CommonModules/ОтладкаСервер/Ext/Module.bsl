Функция ВыполнитьНаСервере(ИмяСценария = "") Экспорт

	СерверноеЗначение = 21;
	СерверныйРезультат = СерверноеЗначение * 2;
	Элемент = Справочники.Товары.СоздатьЭлемент();
	Элемент.Наименование = Справочники.Товары.НаименованиеПоУмолчанию(ИмяСценария);
	Элемент.Записать();
	СерверноеСообщение = СтрШаблон("%1 → %2", Элемент.Наименование, СерверныйРезультат); // BP-LINE-SERVER
	Возврат СерверныйРезультат;

